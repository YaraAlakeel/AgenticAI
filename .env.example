# Copy this file to .env and fill in your key:   cp .env.example .env
# .env is git-ignored. Never commit a real key.

# Required: get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: any OpenRouter model that supports tool calling
MODEL=openai/gpt-4.1-nano
# Optional: used automatically if MODEL fails (rate limit, model removed, ...)
FALLBACK_MODEL=google/gemma-4-31b-it:free
